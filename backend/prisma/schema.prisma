generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  cnpj      String   @unique
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  plan      String   @default("free")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  tenantUsers TenantUser[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  cpf          String   @unique
  name         String
  email        String?  @unique
  passwordHash String   @map("password_hash")
  isRoot       Boolean  @default(false) @map("is_root")
  createdAt    DateTime @default(now()) @map("created_at")

  tenantUsers TenantUser[]

  @@map("users")
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String   @default("standard") // root | admin | standard
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

model Municipality {
  id          String  @id @default(uuid())
  ibgeCode    String  @unique @map("ibge_code")
  name        String
  uf          String
  mesoregion  String?
  lat         Float?
  lng         Float?

  @@map("municipalities")
}

// Tabelas com RLS (Exemplos para o MVP)
model Contact {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  cpf            String?
  phone          String?
  municipalityId String?  @map("municipality_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("contacts")
}
